PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://signalix:signalix@localhost:5432/signalix

# JWT — change these in staging/production
JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin (used for OAuth redirects and password reset links)
FRONTEND_URL=http://localhost:3000

# Google OAuth — create credentials at console.cloud.google.com
# Add GOOGLE_CALLBACK_URL as an authorised redirect URI in the Google Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# GitHub OAuth — create an OAuth App at github.com/settings/developers
# Set the Authorization callback URL to GITHUB_CALLBACK_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Apple OAuth — create a Service ID at developer.apple.com
# The callback URL MUST be HTTPS (Apple rejects plain http, including localhost).
# Use a tunnel (e.g. ngrok) for local development.
# APPLE_PRIVATE_KEY: paste the full .p8 contents with \n replacing real newlines.
APPLE_CLIENT_ID=com.example.signalix
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=https://api.example.com/api/v1/auth/apple/callback

# Email (Resend) — https://resend.com
# Leave RESEND_API_KEY empty to skip sending and log the reset URL to the console instead.
# For local testing, onboarding@resend.dev is a pre-verified Resend sandbox sender.
RESEND_API_KEY=
EMAIL_FROM=Signalix <onboarding@resend.dev>
